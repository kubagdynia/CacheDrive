<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CacheDrive\CacheDrive.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
